generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String       @id @default(cuid())
  email               String?      @unique
  walletAddress       String       @unique
  passwordHash        String?
  
  // Real Trading (USDC)
  usdcBalance         Decimal      @default(0) @db.Decimal(18, 6)
  realLockedBalance   Decimal      @default(0) @db.Decimal(18, 6)
  
  // Demo Trading
  demoBalance         Decimal      @default(10000) @db.Decimal(18, 6)
  demoLockedBalance   Decimal      @default(0) @db.Decimal(18, 6)
  
  // Legacy
  lockedBalance       Decimal      @default(0) @db.Decimal(18, 6)
  fiatBalance         Decimal      @default(0) @db.Decimal(18, 6)
  
  kycStatus           String       @default("pending")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  
  orders              Order[]
  positions           Position[]
  transactions        Transaction[]
  buyerTrades         Trade[]      @relation("BuyerTrades")   // ← ADD THIS
  sellerTrades        Trade[]      @relation("SellerTrades")  // ← ADD THIS
}

model MarketGroup {
  id          Int       @id @default(autoincrement())
  question    String    @db.VarChar(100)
  description String    @db.VarChar(500)
  category    String
  thumbnail   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  markets     Market[]
  
  @@index([category, createdAt])
}

model Market {
  id              Int       @id @default(autoincrement())
  
  // Link to parent question (optional - for multi-option markets)
  marketGroupId   Int?
  marketGroup     MarketGroup? @relation(fields: [marketGroupId], references: [id])
  
  // For standalone markets, use title. For grouped markets, use optionText
  title           String?   @db.VarChar(100)
  optionText      String?   @db.VarChar(50)
  
  description     String
  category        String
  status          String    @default("active")
  resolved        Boolean   @default(false)
  outcome         Boolean?
  yesPrice        Decimal
  noPrice         Decimal
  totalVolume     Decimal   @default(0)
  volume24h       Decimal   @default(0)
  totalLiquidity  Decimal   @default(0)
  traderCount     Int       @default(0)
  createdAt       DateTime  @default(now())
  endDate         DateTime
  resolvedAt      DateTime?
  contractAddress String?
  
  orders          Order[]
  positions       Position[]
  trades          Trade[]
  priceHistory    PriceHistory[]
  
  @@index([marketGroupId, createdAt])
  @@index([category, status, volume24h])
}

model Order {
  id          String   @id @default(cuid())
  userId      String
  marketId    Int
  side        String   // 'yes' or 'no'
  direction   String   // 'buy' or 'sell'
  type        String   // 'market' or 'limit'
  price       Decimal  @db.Decimal(18, 6)
  quantity    Decimal  @db.Decimal(18, 6)
  filled      Decimal  @default(0) @db.Decimal(18, 6)
  remaining   Decimal  @db.Decimal(18, 6)
  status      String   // 'open', 'partial', 'filled', 'cancelled'
  mode        String   @default("demo") // ← ADD THIS: 'demo' or 'real'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id])
  market      Market   @relation(fields: [marketId], references: [id])
  
  @@index([marketId, side, direction, status, mode]) // ← Add mode to index
}

model Trade {
  id            String   @id @default(cuid())
  marketId      Int
  buyOrderId    String
  sellOrderId   String
  buyerUserId   String
  sellerUserId  String
  side          String
  price         Decimal  @db.Decimal(18, 6)
  quantity      Decimal  @db.Decimal(18, 6)
  mode          String   @default("demo") // ← ADD THIS: 'demo' or 'real'
  executedAt    DateTime @default(now())
  
  market        Market   @relation(fields: [marketId], references: [id])
  buyer         User     @relation("BuyerTrades", fields: [buyerUserId], references: [id])
  seller        User     @relation("SellerTrades", fields: [sellerUserId], references: [id])
  
  @@index([marketId, mode]) // ← Add mode to index
}

model Position {
  id            String   @id @default(cuid())
  userId        String
  marketId      Int
  mode          String   @default("demo") // ← ADD THIS: 'demo' or 'real'
  yesShares     Decimal  @default(0) @db.Decimal(18, 6)
  noShares      Decimal  @default(0) @db.Decimal(18, 6)
  avgYesCost    Decimal  @default(0) @db.Decimal(18, 6)
  avgNoCost     Decimal  @default(0) @db.Decimal(18, 6)
  realizedPnL   Decimal  @default(0) @db.Decimal(18, 6)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  user          User     @relation(fields: [userId], references: [id])
  market        Market   @relation(fields: [marketId], references: [id])
  
  @@unique([userId, marketId, mode]) // ← UPDATE: Add mode to unique constraint
}

model Transaction {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  type            String
  amount          Decimal
  currency        String
  status          String    @default("pending")
  stripePaymentId String?
  circlePaymentId String?
  txHash          String?
  metadata        Json?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?
}

model PriceHistory {
  id        Int      @id @default(autoincrement())
  marketId  Int
  market    Market   @relation(fields: [marketId], references: [id])
  yesPrice  Decimal
  noPrice   Decimal
  volume    Decimal
  timestamp DateTime @default(now())
}
