generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String       @id @default(cuid())
  email               String?      @unique
  walletAddress       String       @unique
  passwordHash        String?
  
  // Real Trading (USDC)
  usdcBalance         Decimal      @default(0) @db.Decimal(18, 6)
  realLockedBalance   Decimal      @default(0) @db.Decimal(18, 6)
  
  // Demo Trading
  demoBalance         Decimal      @default(10000) @db.Decimal(18, 6)
  demoLockedBalance   Decimal      @default(0) @db.Decimal(18, 6)
  
  // Legacy (can remove after migration)
  lockedBalance       Decimal      @default(0) @db.Decimal(18, 6)
  fiatBalance         Decimal      @default(0) @db.Decimal(18, 6)
  
  kycStatus           String       @default("pending")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  
  orders              Order[]
  positions           Position[]
  transactions        Transaction[]
}

model MarketGroup {
  id          Int       @id @default(autoincrement())
  question    String    @db.VarChar(100)
  description String    @db.VarChar(500)
  category    String
  thumbnail   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  markets     Market[]
  
  @@index([category, createdAt])
}

model Market {
  id              Int       @id @default(autoincrement())
  
  // Link to parent question (optional - for multi-option markets)
  marketGroupId   Int?
  marketGroup     MarketGroup? @relation(fields: [marketGroupId], references: [id])
  
  // For standalone markets, use title. For grouped markets, use optionText
  title           String?   @db.VarChar(100)
  optionText      String?   @db.VarChar(50)
  
  description     String
  category        String
  status          String    @default("active")
  resolved        Boolean   @default(false)
  outcome         Boolean?
  yesPrice        Decimal
  noPrice         Decimal
  totalVolume     Decimal   @default(0)
  volume24h       Decimal   @default(0)
  totalLiquidity  Decimal   @default(0)
  traderCount     Int       @default(0)
  createdAt       DateTime  @default(now())
  endDate         DateTime
  resolvedAt      DateTime?
  contractAddress String?
  
  orders          Order[]
  positions       Position[]
  trades          Trade[]
  priceHistory    PriceHistory[]
  
  @@index([marketGroupId, createdAt])
  @@index([category, status, volume24h])
}

model Order {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  marketId        Int
  market          Market    @relation(fields: [marketId], references: [id])
  
  side            String    // "yes" or "no"
  direction       String    // "buy" or "sell"
  type            String    // "limit" or "market"
  price           Decimal   @db.Decimal(10, 6)
  quantity        Decimal   @db.Decimal(18, 6)
  filled          Decimal   @default(0) @db.Decimal(18, 6)
  remaining       Decimal   @db.Decimal(18, 6)
  
  status          String    @default("open")
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  trades          Trade[]
  
  @@index([marketId, status, side, direction, price, createdAt])
  @@index([userId])
}

model Trade {
  id           String   @id @default(cuid())
  marketId     Int
  market       Market   @relation(fields: [marketId], references: [id])
  buyOrderId   String
  buyOrder     Order    @relation(fields: [buyOrderId], references: [id])
  sellOrderId  String
  buyerUserId  String
  sellerUserId String
  side         String
  price        Decimal
  quantity     Decimal
  executedAt   DateTime @default(now())
}

model Position {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  marketId    Int
  market      Market   @relation(fields: [marketId], references: [id])
  yesShares   Decimal  @default(0)
  noShares    Decimal  @default(0)
  avgYesCost  Decimal  @default(0)
  avgNoCost   Decimal  @default(0)
  realizedPnL Decimal  @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, marketId])
}

model Transaction {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  type            String
  amount          Decimal
  currency        String
  status          String    @default("pending")
  stripePaymentId String?
  circlePaymentId String?
  txHash          String?
  metadata        Json?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?
}

model PriceHistory {
  id        Int      @id @default(autoincrement())
  marketId  Int
  market    Market   @relation(fields: [marketId], references: [id])
  yesPrice  Decimal
  noPrice   Decimal
  volume    Decimal
  timestamp DateTime @default(now())
}
